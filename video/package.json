{
  "name": "manta-hero-video",
  "private": true,
  "version": "0.0.0",
  "description": "Hero video for mantaui.com — rendered with Remotion, output copied into website/.",
  "scripts": {
    "build:mp4": "remotion render Hero out/hero.mp4 --crf=23 --codec=h264 --muted",
    "build:webm": "remotion render Hero out/hero.webm --codec=vp9",
    "build": "npm run build:mp4 && npm run build:webm && mkdir -p ../website && cp out/hero.mp4 out/hero.webm ../website/",
    "studio": "remotion studio",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.250",
    "@remotion/renderer": "^4.0.250",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "happy-dom": "^15.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "remotion": "^4.0.250",
    "sharp": "^0.35.3",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "vitest": "^4.1.6",
    "zustand": "^4.5.0"
  }
}
